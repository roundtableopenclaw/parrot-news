# Required — copy to `.env.local` and fill in
NODE_ENV=development

AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

DATABASE_URL=

# Optional — full pipeline (script + audio)
OPENAI_API_KEY=
BLOB_READ_WRITE_TOKEN=

# Optional — Postmark inbound webhook (`POST /api/inbound/email`)
POSTMARK_INBOUND_TOKEN=
NEWSLETTER_FORWARDING_ADDRESS=

# Optional — Vercel Cron (`GET /api/cron/daily`); Vercel sends Authorization: Bearer
CRON_SECRET=

# Tooling only (scripts/CI — not read by Next.js at runtime)
# NEON_API_KEY=          # neon.com → Account → API keys → npm run setup:neon
# VERCEL_TOKEN=          # vercel.com → Account → Tokens → npm run check:vercel-env
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
# NEON_PROJECT_ID=       # written by setup:neon
